{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    // 以下、Electron Forge の初期構築から手動で追加分
    "jsx": "react-jsx",
  },
  "include": ["src/**/*", "*.ts", "*.mts"]
}
